__pycache__/
*.pyc
*.pyo
.omc/
.claude/
.venv/
*.env
.env
# Build pins, not secrets. The blanket *.env rule above is for dotenv files
# holding credentials; these record the engine/CUDA versions the TensorFold
# images are built from and MUST be tracked — build.sh and the CI workflows
# both `source` them, and tests/test_tensorfold_image.py skips (rather than
# fails) when they are missing, so leaving them untracked would silently
# disarm that guard.
!docker/rdma-test/image.env
!docker/tensorfold/image.env
!docker/tensorfold-dsv41/image.env
# uv.lock is tracked because the type-check workflow uses uv sync --locked.
reference_materials/
.coverage
/src/sparkrun.egg-info/
/website/node_modules/
/website/.astro/
/website/dist/
/website/package-lock.json
/build/
/benchmarks/
/.slop/
/runs/
/data/
/script-*.sh
.idea/

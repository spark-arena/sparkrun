# Pinned inputs for the sparkrun TensorFold image.
#
# This file is the single source of truth for the engine version and runtime
# libraries.  docker/tensorfold/Dockerfile consumes the values as build args,
# docker/tensorfold/build.sh sources it, and tests/test_tensorfold_image.py
# asserts the platform default image still names the tag built here (a Python
# default naming an image nobody built is worse than no default at all).
#
# The cadence anchor is TF_VERSION: bump it together with IMAGE_TAG when a new
# TensorFold release is qualified.  Do not use :latest — upstream ships several
# releases a week, and a moving tag makes two runs a month apart incomparable.

IMAGE_REPO=ghcr.io/spark-arena/tensorfold
TF_VERSION=1.1.3
IMAGE_TAG=1.1.3

# The release archive is self-contained; this CUDA runtime base supplies the
# driver-facing CUDA userspace (cuBLASLt for --vision/projections) and the
# dynamic loader.  The engine itself only needs libcuda at run time.
CUDA_TAG=13.0.1-runtime-ubuntu24.04

# TensorFold 1.1.x refuses NCCL < 2.30 for native ranks.  The CUDA 13.0.1
# image holds libnccl2 2.28.3; raising it explicitly is required (and
# --allow-change-held-packages is needed because NVIDIA holds the package).
NCCL_APT_VERSION=2.32.3-1+cuda13.4
